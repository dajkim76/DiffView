<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Area Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Main Page Content (Toolbar, Tabs, ViewPager) -->
        <LinearLayout
            android:id="@+id/mainContentPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"
                android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
                app:title="@string/app_name"
                app:titleTextColor="@android:color/white" />

            <!-- Tab & + Button Row -->
            <LinearLayout
                android:id="@+id/llTabBarRow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/tab_bar_bg"
                android:elevation="2dp">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    app:tabMode="scrollable"
                    app:tabGravity="start"
                    app:tabTextAppearance="@style/TabTextAppearance"
                    app:tabTextColor="@color/tab_unselected_color"
                    app:tabSelectedTextColor="@color/tab_selected_color"
                    app:tabIndicatorColor="@color/tab_indicator_color"
                    android:background="@android:color/transparent" />

                <ImageButton
                    android:id="@+id/btnAddDiff"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_add"
                    app:tint="@color/icon_tint_primary"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/title_add_diff" />
            </LinearLayout>

            <!-- Full File Path Below Tab Bar -->
            <TextView
                android:id="@+id/tvFilePathHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/file_path_header_bg"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:textSize="12sp"
                android:textColor="?android:textColorSecondary"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="start"
                android:visibility="gone" />

            <!-- ViewPager Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPager2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvEmptyDiffs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/msg_no_diffs"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Fullscreen Fragment Container (EnterDiffGroup, Settings) -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:elevation="10dp" />

    </FrameLayout>

    <!-- Left Navigation Drawer -->
    <LinearLayout
        android:id="@+id/drawerPane"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="?android:colorBackground">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_header_diff_groups"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="?attr/colorPrimary"
            android:paddingHorizontal="16dp"
            android:paddingVertical="20dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDiffGroups"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/tvEmptyGroups"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/msg_no_diff_groups"
                android:textColor="?android:textColorSecondary"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
