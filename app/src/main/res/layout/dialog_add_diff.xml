<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/etDiffTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_diff_title"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnPickTwoFilesDiff"
            style="@style/App.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_pick_two_files"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/label_before"
                android:textStyle="bold"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPickBeforeDiff"
                style="@style/App.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_pick_before_file"
                android:textSize="11sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etDiffBefore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:hint="@string/hint_before_text"
            android:minLines="3"
            android:maxHeight="130dp"
            android:gravity="top|start"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:background="@drawable/bg_edit_box"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/label_after"
                android:textStyle="bold"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPickAfterDiff"
                style="@style/App.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_pick_after_file"
                android:textSize="11sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etDiffAfter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:hint="@string/hint_after_text"
            android:minLines="3"
            android:maxHeight="130dp"
            android:gravity="top|start"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:background="@drawable/bg_edit_box"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
